strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 57, "version": 1, "versionNonce": 57, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "HandshakeSession(keys, media, firstMediaSequence = SEQX+3, sessionId = H123)", "originalText": "HandshakeSession(keys, media, firstMediaSequence = SEQX+3, sessionId = H123)", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-57", "type": "text", "x": 66, "y": 1193.0, "width": 776.1640625, "height": 28.0, "angle": 0, "strokeColor": "#172b4d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 58, "version": 1, "versionNonce": 58, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "HandshakeDemo imprime apenas media / ID público, fecha o socket e termina o teste.", "originalText": "HandshakeDemo imprime apenas media / ID público, fecha o socket e termina o teste.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-58", "type": "rectangle", "x": 48, "y": 1300, "width": 1504, "height": 130, "angle": 0, "strokeColor": "#d3a458", "backgroundColor": "#fff8eb", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 59, "version": 1, "versionNonce": 59, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "03-handshake-type3-session-59", "type": "text", "x": 70, "y": 1311.0, "width": 363.32080078125, "height": 32.199999999999996, "angle": 0, "strokeColor": "#a35c00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 60, "version": 1, "versionNonce": 60, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Confirmação vista por cada lado", "originalText": "Confirmação vista por cada lado", "fontSize": 23, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-60", "type": "text", "x": 70, "y": 1352.0, "width": 806.720703125, "height": 28.0, "angle": 0, "strokeColor": "#172b4d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 61, "version": 1, "versionNonce": 61, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Servidor: Type 3 verificado → aceita a sessão. Proxy: Type 2 verificado + Type 3 enviado.", "originalText": "Servidor: Type 3 verificado → aceita a sessão. Proxy: Type 2 verificado + Type 3 enviado.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-61", "type": "text", "x": 70, "y": 1380.0, "width": 928.458984375, "height": 28.0, "angle": 0, "strokeColor": "#172b4d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 62, "version": 1, "versionNonce": 62, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "O proxy só terá confirmação da aceitação pelo servidor ao receber um primeiro registo protegido válido.", "originalText": "O proxy só terá confirmação da aceitação pelo servidor ao receber um primeiro registo protegido válido.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-62", "type": "rectangle", "x": 48, "y": 1460, "width": 1504, "height": 175, "angle": 0, "strokeColor": "#8792a2", "backgroundColor": "#f7f8fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 63, "version": 1, "versionNonce": 63, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "03-handshake-type3-session-63", "type": "text", "x": 70, "y": 1471.0, "width": 819.5361328125, "height": 32.199999999999996, "angle": 0, "strokeColor": "#627086", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 64, "version": 1, "versionNonce": 64, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "PRÓXIMA INTEGRAÇÃO · percurso pretendido, ainda sem implementação", "originalText": "PRÓXIMA INTEGRAÇÃO · percurso pretendido, ainda sem implementação", "fontSize": 23, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-64", "type": "text", "x": 70, "y": 1512.0, "width": 880.255859375, "height": 26.599999999999998, "angle": 0, "strokeColor": "#172b4d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 65, "version": 1, "versionNonce": 65, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Browser → pedido HTTP ao proxy → handshake com o servidor → Type 4 (blocos protegidos) → proxy", "originalText": "Browser → pedido HTTP ao proxy → handshake com o servidor → Type 4 (blocos protegidos) → proxy", "fontSize": 19, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-65", "type": "text", "x": 70, "y": 1538.6, "width": 847.57177734375, "height": 26.599999999999998, "angle": 0, "strokeColor": "#172b4d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 66, "version": 1, "versionNonce": 66, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Proxy verifica sequência/tag, decifra e entrega bytes MP4 ao browser → Type 5 (END autenticado).", "originalText": "Proxy verifica sequência/tag, decifra e entrega bytes MP4 ao browser → Type 5 (END autenticado).", "fontSize": 19, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-66", "type": "text", "x": 70, "y": 1565.2, "width": 797.97509765625, "height": 26.599999999999998, "angle": 0, "strokeColor": "#172b4d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 67, "version": 1, "versionNonce": 67, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Falta definir/implementar contadores de nonce, registos Type 4/5, Range/catálogo e métricas.", "originalText": "Falta definir/implementar contadores de nonce, registos Type 4/5, Range/catálogo e métricas.", "fontSize": 19, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "03-handshake-type3-session-67", "type": "text", "x": 70, "y": 1591.8, "width": 847.66455078125, "height": 26.599999999999998, "angle": 0, "strokeColor": "#172b4d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 68, "version": 1, "versionNonce": 68, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "O IV de tráfego derivado aqui é uma base: não se pode reutilizá-lo diretamente em todos os blocos.", "originalText": "O IV de tráfego derivado aqui é uma base: não se pode reutilizá-lo diretamente em todos os blocos.", "fontSize": 19, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}