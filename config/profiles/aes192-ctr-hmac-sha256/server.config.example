<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: provision matching independent SKey and MacKey values in both peer files. -->
<ServerCryptoConfig version="1.0">
    <SymCipherSuite>
        <Algorithm>AES</Algorithm>
        <Mode>CTR</Mode>
        <InitializationVector>
            <IV>NULL</IV>
            <IVSize unit="bits">128</IVSize>
        </InitializationVector>
        <Padding>NULL</Padding>
    </SymCipherSuite>
    <MACSuite><Algorithm>HMAC-SHA256</Algorithm></MACSuite>
    <ConfiguredKeys>
        <SymmetricKey>
            <SKey encoding="hex">REPLACE_WITH_48_HEX_DIGITS</SKey>
            <Keysize>192</Keysize>
        </SymmetricKey>
        <MACKey><MacKey encoding="hex">REPLACE_WITH_INDEPENDENT_64_HEX_DIGITS</MacKey><MacKeySize>256</MacKeySize></MACKey>
    </ConfiguredKeys>
    <!-- Project extension: authenticated key exchange settings, not supplied by the assignment template. -->
    <Handshake>
        <DHGroup>ffdhe2048</DHGroup>
        <Kdf>HKDF-SHA256</Kdf>
        <Authentication>HMAC-SHA256</Authentication>
        <TagSizeBits>256</TagSizeBits>
        <RandomSizeBytes>32</RandomSizeBytes>
        <MaxPayloadBytes>65536</MaxPayloadBytes>
        <SocketTimeoutMillis>10000</SocketTimeoutMillis>
        <MaxStreamRecords>1048576</MaxStreamRecords>
    </Handshake>
</ServerCryptoConfig>
