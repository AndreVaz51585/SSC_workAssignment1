<?xml version="1.0" encoding="UTF-8"?>
<!-- Template only. Provision the SAME random PSK in this file and its matching peer file. No real secret is stored here. -->
<ProxyCryptoConfig version="1.0">
    <SymCipherSuite>
        <Algorithm>AES</Algorithm>
        <Mode>GCM</Mode>
        <InitializationVector>
            <IV>NULL</IV>
            <IVSize unit="bits">96</IVSize>
        </InitializationVector>
        <Padding>NULL</Padding>
    </SymCipherSuite>
    <MACSuite><Algorithm>NULL</Algorithm></MACSuite>
    <ConfiguredKeys>
        <SymmetricKey>
            <SKey encoding="hex">REPLACE_WITH_64_HEX_DIGITS</SKey>
            <Keysize>256</Keysize>
        </SymmetricKey>
        <MACKey><MacKey>NULL</MacKey><MacKeySize>NULL</MacKeySize></MACKey>
    </ConfiguredKeys>
    <!-- Project extension: authenticated key exchange settings, not supplied by the assignment template. -->
    <Handshake>
        <DHGroup>ffdhe2048</DHGroup>
        <Kdf>HKDF-SHA256</Kdf>
        <Authentication>HMAC-SHA256</Authentication>
        <TagSizeBits>128</TagSizeBits>
        <RandomSizeBytes>32</RandomSizeBytes>
        <MaxPayloadBytes>65536</MaxPayloadBytes>
        <SocketTimeoutMillis>10000</SocketTimeoutMillis>
        <MaxStreamRecords>1048576</MaxStreamRecords>
    </Handshake>
</ProxyCryptoConfig>
